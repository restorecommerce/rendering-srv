{
  "name": "@restorecommerce/rendering-srv",
  "version": "1.2.3",
  "description": "Handlebars-HTML rendering microservice",
  "main": "lib/worker.js",
  "author": "n-fuse GmbH",
  "repository": {
    "type": "git",
    "url": "https://github.com/restorecommerce/rendering-srv.git"
  },
  "license": "MIT",
  "keywords": [
    "microservice",
    "rendering"
  ],
  "type": "module",
  "dependencies": {
    "@restorecommerce/chassis-srv": "^1.9.1",
    "@restorecommerce/grpc-client": "^2.3.1",
    "@restorecommerce/handlebars-helperized": "^2.1.1",
    "@restorecommerce/kafka-client": "^1.4.1",
    "@restorecommerce/logger": "^1.4.1",
    "@restorecommerce/rc-grpc-clients": "^5.2.1",
    "@restorecommerce/service-config": "^1.2.1",
    "cheerio": "^1.2.0",
    "nice-grpc-server-reflection": "^3.0.5",
    "redis": "^6.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@restorecommerce/dev": "^0.3.0",
    "@semantic-release-plus/docker": "^3.1.3",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "husky": "9.1.7",
    "nodemon": "^3.1.14",
    "npm-run-all2": "^9.0.2",
    "rimraf": "^6.1.3",
    "should": "^13.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  },
  "scripts": {
    "start": "node lib/start.cjs",
    "dev": "cross-env NODE_ENV=development node --watch lib/start.cjs",
    "test": "vitest run",
    "lint": "eslint src",
    "build:es": "node esbuild.mjs",
    "build:clean": "rimraf lib",
    "build": "npm-run-all lint build:clean build:es",
    "prepare": "node -e \"try { require('husky').install() } catch (e) {}\""
  },
  "engines": {
    "node": ">= 20.8.0"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github",
      [
        "@semantic-release-plus/docker",
        {
          "name": "docker.io/restorecommerce/rendering-srv",
          "skipLogin": true
        }
      ],
      [
        "@semantic-release-plus/docker",
        {
          "name": "ghcr.io/restorecommerce/rendering-srv",
          "skipLogin": true
        }
      ]
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
